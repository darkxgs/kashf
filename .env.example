# Postgres. Without it, Kashf runs on an embedded Postgres (PGlite) in .data/.
# On Neon, use the pooled URL here and the direct one below for migrations.
# Kashf keeps its tables in their own "kashf" schema, so it can share a database.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# The public address, used for links in reports and the demo store audit.
# Vercel provides one automatically.
KASHF_PUBLIC_URL=

# Google PageSpeed Insights. Runs by default on Vercel; set KASHF_PSI=1 to run
# it locally or 0 to turn it off. A free API key avoids Google's anonymous limits.
KASHF_PSI=
PAGESPEED_API_KEY=

# Salt for hashing visitor IPs in the rate limit (12 checks an hour).
# Any long random string; the IP itself is never stored.
RATE_SALT=

# Set to 1 to allow checking localhost and private addresses under `next start`.
# They're always allowed under `next dev`, and never on Vercel unless set here.
KASHF_ALLOW_PRIVATE=
